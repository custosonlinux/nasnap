# NaSnap — Environment Configuration
# Copy to .env and fill in the values before starting

# Password for the built-in admin account (set once on first start)
NASNAP_ADMIN_PASSWORD=changeme

# HMAC key for session tokens — generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production

# Optional tuning
# SESSION_HOURS=8
# WORKERS=2
# PORT=5000

# Timezone for time-of-day settings (e.g. digest report send time). Defaults to UTC.
# TZ=Europe/Berlin
